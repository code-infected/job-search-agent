# Model provider selection: the only thing to change to switch vendors.
MODEL_PROVIDER=anthropic   # openai | anthropic | google | ollama
MODEL_NAME=                # the model id within that provider

# Only the key matching MODEL_PROVIDER above is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Tracing and evals (provider-independent). Traces include posting text and candidate facts.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=job-search-agent

# Storage
VECTOR_STORE_PATH=./data/chroma
CHECKPOINT_DB=./data/checkpoints.sqlite
FACTS_PATH=./data/facts.json
SEARCH_CONFIG_PATH=./data/search.json
DRAFTS_DIR=./data/drafts

# Reviews waiting longer than this are listed by `python cli.py digest`.
REVIEW_STALE_HOURS=24

# Drafts: file writes to DRAFTS_DIR, gmail creates a Gmail draft. Neither ever sends.
DRAFT_BACKEND=file
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional job search across many employers in one country. Free key: developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Run automatically every N hours while the web app is open. 0 is off, otherwise at least 6.
AUTO_RUN_HOURS=0

# Guardrails
MAX_POSTINGS_PER_RUN=25
MAX_COST_PER_RUN_USD=2.00
MAX_TOKENS_PER_RUN=500000
FIT_SCORE_THRESHOLD=0.7
REQUEST_DELAY_SECONDS=1.0
# Your model's prices, used for the cost ceiling. Left at 0, only the token ceiling applies.
MODEL_INPUT_USD_PER_MTOK=0
MODEL_OUTPUT_USD_PER_MTOK=0
